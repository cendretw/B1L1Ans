<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>龍騰英文1-U1解答與投影講解教學系統</title>
    <!-- 引入 Inter 現代字型與 Lucide 圖示 -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6366F1;
            --primary-hover: #4F46E5;
            --primary-light: #EEF2FF;
            --primary-dark: #3730A3;
            --accent: #EC4899;
            --bg-main: #F8FAFC;
            --surface: #FFFFFF;
            --text-dark: #0F172A;
            --text-muted: #64748B;
            --border: #E2E8F0;
            --radius-lg: 16px;
            --radius-md: 10px;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            --font-scale: 1;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        
        body {
            background-color: var(--bg-main);
            color: var(--text-dark);
            font-size: calc(16px * var(--font-scale));
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 頂部 Header - 完全復刻截圖質感 */
        .app-header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 0.85rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            sticky: top;
            top: 0;
            z-index: 50;
            box-shadow: var(--shadow-sm);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            background: linear-gradient(135deg, #6366F1, #8B5CF6);
            color: white;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        .brand-title {
            font-size: calc(1.15rem * var(--font-scale));
            font-weight: 700;
            color: #1E293B;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-subtitle {
            font-size: calc(0.75rem * var(--font-scale));
            color: var(--text-muted);
            font-weight: 400;
        }

        .badge-lesson {
            background: var(--primary-light);
            color: var(--primary-dark);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: calc(0.75rem * var(--font-scale));
            font-weight: 600;
        }

        /* 工具控制區 */
        .toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .tool-group {
            display: flex;
            align-items: center;
            background: #F1F5F9;
            padding: 3px;
            border-radius: 10px;
            border: 1px solid var(--border);
        }

        .btn-tool {
            background: transparent;
            border: none;
            padding: 6px 12px;
            border-radius: 7px;
            font-size: calc(0.85rem * var(--font-scale));
            font-weight: 600;
            color: var(--text-dark);
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-tool:hover { background: var(--surface); }
        .btn-tool.active { background: var(--surface); color: var(--primary); box-shadow: var(--shadow-sm); }
        
        .btn-action {
            background: var(--primary);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            font-size: calc(0.85rem * var(--font-scale));
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 2px 4px rgba(99, 102, 241, 0.2);
        }
        .btn-action:hover { background: var(--primary-hover); }

        /* Navigation Tabs - 現代化動態標籤 */
        .nav-tabs-container {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 0 2rem;
            display: flex;
            gap: 8px;
            overflow-x: auto;
        }

        .nav-tab {
            padding: 12px 18px;
            font-size: calc(0.9rem * var(--font-scale));
            font-weight: 600;
            color: var(--text-muted);
            border-bottom: 3px solid transparent;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-tab:hover { color: var(--primary); background: #F8FAFC; }
        .nav-tab.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
            background: #F1F5F9;
            border-radius: 8px 8px 0 0;
        }

        /* 內容區塊 container */
        .main-container {
            flex-grow: 1;
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 2rem;
        }

        /* 卡片設計 */
        .q-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s;
        }

        .q-card:hover { box-shadow: var(--shadow-md); border-color: #CBD5E1; }
        
        .card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .q-tag {
            background: var(--primary-light);
            color: var(--primary-dark);
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 8px;
            font-size: calc(0.9rem * var(--font-scale));
        }

        /* 文章對照區塊 */
        .passage-box {
            background: #EFF6FF;
            border-left: 4px solid #3B82F6;
            padding: 20px;
            border-radius: 0 var(--radius-md) var(--radius-md) 0;
            margin-bottom: 24px;
            line-height: 1.7;
            font-size: calc(1rem * var(--font-scale));
        }

        .passage-title { font-weight: 700; color: #1E40AF; margin-bottom: 8px; }

        /* 純解答區 (快速對答案) */
        .grading-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 16px;
        }

        .grading-item {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 16px;
            text-align: center;
            box-shadow: var(--shadow-sm);
        }

        .grading-num { font-size: calc(0.85rem * var(--font-scale)); color: var(--text-muted); font-weight: 600; margin-bottom: 4px; }
        .grading-ans { font-size: calc(1.4rem * var(--font-scale)); font-weight: 800; color: #D97706; }

        .sec-title-banner {
            grid-column: 1 / -1;
            font-size: calc(1.1rem * var(--font-scale));
            font-weight: 700;
            color: var(--primary-dark);
            background: var(--primary-light);
            padding: 10px 16px;
            border-radius: 8px;
            margin-top: 16px;
        }

        /* 翻譯分段色塊 */
        .trans-block {
            line-height: 2.2;
            font-size: calc(1.1rem * var(--font-scale));
            background: #F8FAFC;
            padding: 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border);
        }

        .seg { display: inline-block; padding: 2px 8px; margin: 2px; border-radius: 6px; font-weight: 600; }
        .seg-1 { background: #E0F2FE; color: #0369A1; } /* 天藍 */
        .seg-2 { background: #FCE7F3; color: #BE185D; } /* 桃紅 */
        .seg-3 { background: #DCFCE7; color: #15803D; } /* 綠色 */
        .seg-4 { background: #FEF3C7; color: #B45309; } /* 橘黃 */
        .score-badge { font-size: 0.75em; opacity: 0.85; margin-left: 4px; font-weight: 700;}

        /* 全螢幕彈窗 Modal */
        .modal-mask {
            display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px); z-index: 100; justify-content: center; align-items: center; padding: 20px;
        }
        .modal-mask.active { display: flex; }

        .modal-window {
            background: var(--surface); width: 100%; max-width: 1000px; height: 90vh;
            border-radius: 20px; display: flex; flex-direction: column; position: relative;
            box-shadow: var(--shadow-lg); overflow: hidden;
        }

        .modal-header {
            padding: 16px 24px; background: #F8FAFC; border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center; z-index: 10;
        }

        .modal-body {
            flex-grow: 1; padding: 32px; overflow-y: auto; z-index: 5;
            font-size: calc(1.2rem * var(--font-scale)); line-height: 1.7;
        }

        /* 畫布劃記圖層 */
        #annotation-canvas {
            position: absolute; inset: 0; z-index: 20; pointer-events: none;
        }
        .drawing-active #annotation-canvas { pointer-events: auto; cursor: crosshair; }

        /* 畫筆浮動工具列 */
        .pen-bar {
            position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
            background: #1E293B; color: white; padding: 8px 16px; border-radius: 30px;
            display: none; gap: 12px; align-items: center; z-index: 30; box-shadow: var(--shadow-lg);
        }
        .drawing-active .pen-bar { display: flex; }

        .color-dot { width: 24px; height: 24px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }
        .color-dot.active { border-color: white; transform: scale(1.15); }

        /* 隱藏/顯示答案區 */
        .ans-box {
            display: none; margin-top: 20px; padding: 20px; background: #FEF2F2;
            border-left: 4px solid #EF4444; border-radius: 0 var(--radius-md) var(--radius-md) 0;
        }
        .ans-box.show { display: block; }
    </style>
</head>
<body>

    <!-- App Header -->
    <header class="app-header">
        <div class="brand">
            <div class="brand-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            </div>
            <div>
                <div class="brand-title">英文1 進階卷 解答與投影教學 <span class="badge-lesson">L1 Firsts in Life</span></div>
                <div class="brand-subtitle">專為大螢幕投影、考卷對答案、彩色分段配分與隨堂劃記設計</div>
            </div>
        </div>

        <div class="toolbar">
            <button id="draw-toggle-btn" class="btn-tool" onclick="toggleDrawingMode()">
                ✏️ 劃記：已關閉
            </button>
            <div class="tool-group">
                <button class="btn-tool" onclick="adjustFont(-0.1)">-</button>
                <span style="font-size:0.85rem; font-weight:700; padding:0 8px;" id="scale-indicator">100%</span>
                <button class="btn-tool" onclick="adjustFont(0.1)">+</button>
                <button class="btn-tool" onclick="setFontScale(1.75)" style="color:var(--primary);">特大投影</button>
            </div>
            <button class="btn-action" onclick="toggleFullScreen()">全螢幕</button>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="nav-tabs-container" id="tabs-bar"></nav>

    <!-- Main View Content -->
    <main class="main-container" id="view-content"></main>

    <!-- Fullscreen Modal for Classroom Discussion -->
    <div class="modal-mask" id="detail-modal">
        <div class="modal-window" id="modal-window">
            <div class="modal-header">
                <h3 id="modal-heading" style="font-size: calc(1.1rem * var(--font-scale)); color: var(--text-dark);">題目詳解模式</h3>
                <div style="display:flex; gap:10px;">
                    <button class="btn-action" style="background:#EF4444;" onclick="closeQuestionModal()">關閉視窗 (Esc)</button>
                </div>
            </div>
            
            <div class="modal-body" id="modal-body-container"></div>
            
            <!-- Canvas Overlay for Drawing -->
            <canvas id="annotation-canvas"></canvas>

            <!-- Floating Drawing Toolbar -->
            <div class="pen-bar">
                <span style="font-size:0.8rem; font-weight:600;">劃記筆：</span>
                <div class="color-dot active" style="background: rgba(253, 224, 71, 0.6);" onclick="selectPen('rgba(253, 224, 71, 0.6)', 18, this)"></div>
                <div class="color-dot" style="background: rgba(244, 114, 182, 0.6);" onclick="selectPen('rgba(244, 114, 182, 0.6)', 18, this)"></div>
                <div class="color-dot" style="background: #EF4444;" onclick="selectPen('#EF4444', 3, this)"></div>
                <button class="btn-tool" style="color:white; background:rgba(255,255,255,0.2); margin-left:8px;" onclick="resetCanvas()">清空劃記</button>
            </div>
        </div>
    </div>

<script>
    // --- 完整試卷資料庫 (包含PDF全部內容) ---
    const FULL_EXAM_DATA = {
        // 純答案專用
        gradingKeys: [
            { title: 'I. 文意字彙與詞類變化', items: ['1. reply', '2. skipped', '3. accident', '4. upset', '5. traditional', '6. reflecting', '7. ruined', '8. fortunate', '9. memorize', '10. depression'] },
            { title: 'II. 綜合測驗', items: ['11. (C)', '12. (A)', '13. (B)', '14. (A)', '15. (C)', '16. (D)', '17. (C)', '18. (B)', '19. (A)', '20. (D)'] },
