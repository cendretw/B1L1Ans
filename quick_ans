        translations: [
            {
                num: 37,
                ch: '那家餐廳的牛排吃起來像鞋子的皮革。(5%)',
                segs: [
                    { text: 'The steak in that restaurant', score: '2%', cls: 'seg-1' },
                    { text: 'tastes like', score: '2%', cls: 'seg-2' },
