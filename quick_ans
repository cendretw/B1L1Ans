        ],
        // 各大題題目細節
        sections: {
            "sec_vocab": {
                name: "I. 文意字彙",
                questions: [
                    { id: 1, q: "Peter didn't r______y when I asked him whether he wanted another cup of coffee.", a: "reply", detail: "ask（詢問）後沒有「回覆 (reply)」。" },
                    { id: 2, q: "Miss Lin s______ped the details of the passage and talked only about the main idea.", a: "skipped", detail: "語意為「跳過 (skipped)」細節，僅討論主旨。注意 p 重複字尾加 ed。" },
                    { id: 3, q: "The study shows that a falling rock caused the a______t on the mountain road.", a: "accident", detail: "落石造成山路上的「意外事故 (accident)」。" },
                    { id: 4, q: "Although she was u______t that she didn't win the science competition, Diana picked herself up and decided simply to work harder on her next project.", a: "upset", detail: "雖然沒有獲勝感到「難過沮喪的 (upset)」。" },
                    { id: 5, q: "During the harvest festival, people of this tribe wore t______l costumes, danced to their tribal music, and enjoyed local foods.", a: "traditional", detail: "穿著「傳統的 (traditional)」服裝。" },
                    { id: 6, q: "Alex's manager asked him to spend some time r______ting on how he could improve his performance.", a: "reflecting", detail: "spend time V-ing，花時間「反省/思考 (reflecting)」。" },
                    { id: 7, q: "Linda really looked forward to the outdoor party, so she felt very disappointed when a sudden, heavy rainstorm r______ned it.", a: "ruined", detail: "暴風雨「毀了 (ruined)」戶外派對。" },
                    { id: 8, q: "The Lin family was ______ (fortunately) to have survived the five-car pile-up on the highway.", a: "fortunate", detail: "was 後面接形容詞「幸運的 (fortunate)」。" },
                    { id: 9, q: "Zoe managed to ______ (memory) the whole article within an hour.", a: "memorize", detail: "managed to + 動詞原形「背誦 (memorize)」。" },
                    { id: 10, q: "Amy has suffered from ______ (depress) since her parents passed away.", a: "depression", detail: "suffer from + 名詞「憂鬱症 (depression)」。" }
                ]
            },
            "sec_cloze": {
                name: "III. 文意選填",
                options: "(A) perfect (B) put; first (C) depressed (D) experience (E) yell (F) let; down (G) laugh (H) realize (I) remind (J) embarrassment",
                passage: "On my first day of high school, I was so excited. I was hoping for a(n) [ 21 ] stage of my life. However, the day turned out to be an awful [ 22 ]. While running to class, I slipped on the wet floor. To avoid falling, I grabbed the first thing that came to hand. This, much to my [ 23 ], happened to be the handle of a fire alarm on the wall... I felt extremely awkward and [ 24 ]. I was worried that I might be punished and thus [ 25 ] my parents [ 25 ]. Soon, I was told that the principal wanted to see me. I was terrified that he would [ 26 ] at me in his office...",
                questions: [
                    { id: 21, q: "I was hoping for a(n) [ 21 ] stage of my life.", a: "(A) perfect", detail: "期待高中生活有一個「完美的 (perfect)」開端。" },
                    { id: 22, q: "However, the day turned out to be an awful [ 22 ].", a: "(D) experience", detail: "轉折語氣，結果變成一次糟糕的「經驗 (experience)」。" },
                    { id: 23, q: "This, much to my [ 23 ], happened to be...", a: "(J) embarrassment", detail: "much to one's embarrassment 意為「令某人極為尷尬的是」。" },
                    { id: 24, q: "I felt extremely awkward and [ 24 ].", a: "(C) depressed", detail: "形容詞對稱，感到十分尷尬與「沮喪的 (depressed)」。" },
                    { id: 25, q: "...and thus [ 25 ] my parents [ 25 ].", a: "(F) let; down", detail: "片語 let one's parents down 意為「讓父母失望」。" },
                    { id: 26, q: "I was terrified that he would [ 26 ] at me in his office.", a: "(E) yell", detail: "yell at sb. 意為「對某人大吼大叫」。" },
                    { id: 27, q: "...and should always [ 27 ] safety [ 27 ].", a: "(B) put; first", detail: "put safety first 意為「把安全放在第一位」。" },
                    { id: 28, q: "...gave everyone a good [ 28 ] to start the term.", a: "(G) laugh", detail: "give everyone a good laugh 意為「帶給大家會心一笑/歡笑」。" },
                    { id: 29, q: "This made me [ 29 ] something valuable...", a: "(H) realize", detail: "make sb. realize 意為「使某人體會/領悟到」。" },
                    { id: 30, q: "I [ 30 ] myself to stay calm.", a: "(I) remind", detail: "remind oneself to V 意為「提醒自己保持冷靜」。" }
                ]
            },
            "sec_reading": {
                name: "IV. 閱讀測驗",
                passage: "During the COVID-19 pandemic*, remote learning became a new way of receiving education. Since then, it has changed many people's learning experiences. In fact, remote learning comes with both benefits and challenges...\nA major advantage lies in its flexibility* and comfort. Imagine this: A student gets up in the morning, enjoys a relaxing breakfast, and prepares for a day of learning right in his or her own home...",
                questions: [
                    { id: 31, q: "What is the best title for this passage?", a: "(D) The Pros and Cons of Remote Learning", detail: "文章探討了遠距學習的優點 (benefits) 與挑戰 (challenges)，即利弊分析。" },
                    { id: 32, q: "According to the passage, what is a positive aspect of remote learning?", a: "(A) It provides a flexible and comfortable learning environment.", detail: "第二段開頭明確指出優勢在於 flexibility and comfort。" },
                    { id: 33, q: "Judging from the final sentence, what is the author's attitude toward remote learning?", a: "(C) Optimistic.", detail: "文末提及以積極態度可以迎向挑戰並善用教育機會，展現樂觀態度。" }
                ]
            },
            "sec_mixed": {
                name: "V. 混合題",
                passage: "【Claire's Draft】\nI was chosen as the speaker for my team to present our work to the class. Because I didn't attend several group meetings, it turned out to be the first-ever failure of my life so far. I failed and felt embarrassed in front of my classmates and teacher. My group received a very low grade...\n\n【AI Chatbot Suggestions】\n(A) Introduce setting (B) Express feelings before (C) Talk about key parts/lessons (D) Describe senses (E) Share emotions (F) Include conversation details (G) End with changed values",
                questions: [
                    { id: 34, q: "Claire gave a poor group (1) ______ in class... do careful (2) ______ before taking part in any activity.", a: "(1) presentation ; (2) preparation", detail: "(1) 名詞 presentation (簡報/呈現) ; (2) 名詞 preparation (準備)。" },
                    { id: 35, q: "Which ONES does Claire NOT follow in her story? (多選)", a: "(A)(B)(F)", detail: "草稿中未提及：(A)時間地點設定、(B)事前感受、(F)當時對話細節。" },
                    { id: 36, q: "What does 'something or someone' refer to in Claire's story?", a: "failure", detail: "指第一段提出的 first-ever failure。" }
                ]
            }
        }
    };

    // 選項 Tabs
    const TABS_CONFIG = [
        { id: 'tab_grading', label: '✓ 學生快速改考卷 (純答案)' },
        { id: 'tab_trans', label: '★ 總覽與翻譯彩色分段' },
        { id: 'sec_vocab', label: 'I. 文意字彙' },
        { id: 'sec_cloze', label: 'III. 文意選填' },
        { id: 'sec_reading', label: 'IV. 閱讀測驗' },
        { id: 'sec_mixed', label: 'V. 混合題' }
    ];

    let activeTab = 'tab_grading';
    let currentScale = 1.0;
    
    // 畫筆系統狀態
    let isDrawingEnabled = false;
    let isMouseDown = false;
    let strokeColor = 'rgba(253, 224, 71, 0.6)';
    let strokeWidth = 18;
    let canvasContext = null;

    window.onload = () => {
        renderNavigationTabs();
        switchViewTab(activeTab);
        setupCanvasListeners();
    };

    function renderNavigationTabs() {
        const bar = document.getElementById('tabs-bar');
        bar.innerHTML = TABS_CONFIG.map(tab => 
            `<div class="nav-tab ${tab.id === activeTab ? 'active' : ''}" onclick="switchViewTab('${tab.id}')">${tab.label}</div>`
        ).join('');
    }

    function switchViewTab(tabId) {
        activeTab = tabId;
        renderNavigationTabs();
        const view = document.getElementById('view-content');
        view.innerHTML = '';

        if (tabId === 'tab_grading') {
            renderGradingView(view);
        } else if (tabId === 'tab_trans') {
            renderTranslationView(view);
        } else {
            renderSectionView(tabId, view);
        }
    }

    /* 渲染純答案 */
    function renderGradingView(container) {
        let html = `<div style="margin-bottom:20px;"><h2 style="font-weight:700;">學生互改與速查專區 (純標準答案)</h2></div><div class="grading-grid">`;
        FULL_EXAM_DATA.gradingKeys.forEach(sec => {
            html += `<div class="sec-title-banner">${sec.title}</div>`;
            sec.items.forEach(item => {
                let parts = item.split('. ');
                let num = parts[0];
                let ans = parts[1] || parts[0];
                html += `
                    <div class="grading-item">
                        <div class="grading-num">${num}</div>
                        <div class="grading-ans">${ans}</div>
                    </div>
                `;
            });
        });
        html += `</div>`;
        container.innerHTML = html;
    }

    /* 渲染翻譯彩色分段 */
    function renderTranslationView(container) {
        let html = `<div style="margin-bottom:20px;">
            <h2 style="font-weight:700;">VI. 翻譯題 (評分標準：分段給分，每一段錯1字扣1分直到該段扣完為止)</h2>
        </div>`;
        FULL_EXAM_DATA.translations.forEach(t => {
            html += `
                <div class="q-card">
                    <div class="card-top">
                        <span class="q-tag">第 ${t.num} 題</span>
                    </div>
                    <div style="font-weight:700; font-size:calc(1.1rem * var(--font-scale)); margin-bottom:12px;">${t.ch}</div>
                    <div class="trans-block">`;
            t.segs.forEach(s => {
                html += `<span class="seg ${s.cls}">${s.text} <span class="score-badge">[${s.score}]</span></span>`;
            });
            html += `</div></div>`;
        });
        container.innerHTML = html;
    }

    /* 渲染各大題題目 */
    function renderSectionView(secKey, container) {
        const data = FULL_EXAM_DATA.sections[secKey];
        if (!data) return;

        let html = `<h2 style="font-weight:700; margin-bottom:20px;">${data.name}</h2>`;
        
        if (data.passage) {
            html += `<div class="passage-box"><div class="passage-title">📜 閱讀文本 / 情境：</div>${data.passage.replace(/\n/g, '<br>')}</div>`;
        }

        if (data.options) {
            html += `<div style="background:#FFFBEB; border:1px solid #FCD34D; padding:12px 18px; border-radius:10px; margin-bottom:20px; font-weight:600; color:#92400E;">選項箱：${data.options}</div>`;
        }

        data.questions.forEach(q => {
            html += `
                <div class="q-card">
                    <div class="card-top">
                        <span class="q-tag">第 ${q.id} 題</span>
                        <button class="btn-action" onclick="openQuestionModal('${secKey}', ${q.id})">點擊大螢幕檢討 🔍</button>
                    </div>
                    <div style="font-size:calc(1.1rem * var(--font-scale)); font-weight:500;">${q.q}</div>
                </div>
            `;
        });
        container.innerHTML = html;
    }

    /* 開啟投影彈窗 */
    function openQuestionModal(secKey, qId) {
        const sec = FULL_EXAM_DATA.sections[secKey];
        const q = sec.questions.find(x => x.id === qId);

        let body = '';
        if (sec.passage) {
            body += `<div class="passage-box" style="margin-bottom:20px; font-size:0.95em;">${sec.passage.replace(/\n/g, '<br>')}</div>`;
        }
        if (sec.options) {
            body += `<div style="background:#FFFBEB; padding:10px 15px; border-radius:8px; margin-bottom:15px; font-size:0.9em; font-weight:600; color:#92400E;">選項：${sec.options}</div>`;
        }
        body += `
            <div style="font-weight:700; font-size:calc(1.3rem * var(--font-scale)); margin-bottom:24px; color:#1E293B;">${q.id}. ${q.q}</div>
            <button class="btn-action" id="reveal-ans-btn" onclick="document.getElementById('modal-ans-box').classList.add('show'); this.style.display='none';">顯示詳解與答案</button>
            <div class="ans-box" id="modal-ans-box">
                <div style="font-size:calc(1.4rem * var(--font-scale)); font-weight:800; color:#DC2626; margin-bottom:8px;">標準答案：${q.a}</div>
                <div style="color:#475569; font-weight:500;"><strong>解析：</strong>${q.detail}</div>
            </div>
        `;

        document.getElementById('modal-heading').innerText = `${sec.name} - 第 ${qId} 題`;
        document.getElementById('modal-body-container').innerHTML = body;
        document.getElementById('detail-modal').classList.add('active');

        setTimeout(syncCanvasSize, 100);
    }

    function closeQuestionModal() {
        document.getElementById('detail-modal').classList.remove('active');
        resetCanvas();
    }

    /* 縮放系統 */
    function adjustFont(delta) {
        currentScale = Math.max(0.8, Math.min(2.5, currentScale + delta));
        applyFontScale();
    }
    function setFontScale(scale) {
        currentScale = scale;
        applyFontScale();
    }
    function applyFontScale() {
        document.documentElement.style.setProperty('--font-scale', currentScale);
        document.getElementById('scale-indicator').innerText = Math.round(currentScale * 100) + '%';
        setTimeout(syncCanvasSize, 150);
    }

    /* 全螢幕切換 */
    function toggleFullScreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen();
        } else {
            if (document.exitFullscreen) document.exitFullscreen();
        }
    }

    /* 劃記畫布 logic */
    function toggleDrawingMode() {
        isDrawingEnabled = !isDrawingEnabled;
        const btn = document.getElementById('draw-toggle-btn');
        const modal = document.getElementById('modal-window');

        if (isDrawingEnabled) {
            btn.innerText = '✏️ 劃記：已開啟';
            btn.classList.add('active');
            modal.classList.add('drawing-active');
        } else {
            btn.innerText = '✏️ 劃記：已關閉';
            btn.classList.remove('active');
            modal.classList.remove('drawing-active');
        }
    }

    function selectPen(color, width, el) {
        strokeColor = color;
        strokeWidth = width;
        document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('active'));
        if (el) el.classList.add('active');
    }

    function setupCanvasListeners() {
        const cvs = document.getElementById('annotation-canvas');
        canvasContext = cvs.getContext('2d');

        cvs.addEventListener('mousedown', (e) => {
            if (!isDrawingEnabled) return;
            isMouseDown = true;
            const pos = getCanvasPos(cvs, e);
            canvasContext.beginPath();
            canvasContext.moveTo(pos.x, pos.y);
        });

        cvs.addEventListener('mousemove', (e) => {
            if (!isMouseDown || !isDrawingEnabled) return;
            const pos = getCanvasPos(cvs, e);
            canvasContext.lineWidth = strokeWidth;
            canvasContext.lineCap = 'round';
            canvasContext.strokeStyle = strokeColor;
            canvasContext.lineTo(pos.x, pos.y);
            canvasContext.stroke();
        });

        window.addEventListener('mouseup', () => { isMouseDown = false; });
    }

    function getCanvasPos(cvs, e) {
        const rect = cvs.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    function syncCanvasSize() {
        const cvs = document.getElementById('annotation-canvas');
        const win = document.getElementById('modal-window');
        if (cvs && win) {
            cvs.width = win.clientWidth;
            cvs.height = win.clientHeight;
        }
    }

    function resetCanvas() {
        const cvs = document.getElementById('annotation-canvas');
        if (canvasContext && cvs) {
            canvasContext.clearRect(0, 0, cvs.width, cvs.height);
        }
    }
</script>
</body>
</html>
